# Environment Configuration
# ==========================

# Application
APP_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=construction_takeoff
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ODA File Converter (optional - for DWG support)
# Download from: https://www.opendesign.com/guestfiles/oda_file_converter
# ODA_CONVERTER_PATH=C:/Program Files/ODA/ODAFileConverter/ODAFileConverter.exe

# For Linux/Docker:
# ODA_CONVERTER_PATH=/opt/ODAFileConverter/ODAFileConverter
